# --- AI-IDS Environment Configuration ---
APP_ENV=development
APP_NAME=AI-IDS
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_JWT_ALGORITHM=HS256
APP_JWT_EXPIRE_MINUTES=720

# Database (SQLite by default; PostgreSQL-compatible SQLAlchemy URL)
DATABASE_URL=sqlite:////absolute/path/to/data/ai_ids.db
# DATABASE_URL=postgresql+psycopg://user:pass@db:5432/aiids

# CORS origins consumed by the frontend dev server / deployment
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Uploads & artifacts
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./artifacts
MAX_UPLOAD_MB=200

# Bootstrap admin (created on first start)
BOOTSTRAP_ADMIN_EMAIL=admin@ai-ids.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123

# Live capture (requires authorized interfaces + packet capture permissions)
LIVE_CAPTURE_ENABLED=true
LIVE_CAPTURE_BATCH_SIZE=200
LIVE_CAPTURE_QUEUE_MAX=1000

# Threat intelligence (optional; app works without keys)
TI_PROVIDER=none
TI_API_KEY=
TI_CACHE_TTL_SECONDS=86400

# SMTP notifications (optional)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@ai-ids.local

# Rate limiting (requests per minute per IP per bucket)
RATE_LIMIT_PER_MINUTE=300
